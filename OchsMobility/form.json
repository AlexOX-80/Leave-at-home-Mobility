{
  "elements": [
    {
      "type": "Label",
      "caption": "Ochs Mobility nutzt für Bahnverbindungen nur die offizielle DB Timetables API. Aktuell werden direkte Verbindungen erkannt und in Echtzeit überwacht."
    },
    {
      "type": "ExpansionPanel",
      "caption": "DB Timetables / Direktverbindung",
      "items": [
        {"type": "ValidationTextBox", "name": "FromStopName", "caption": "Startbahnhof (Name, z. B. Ehingen (Donau))"},
        {"type": "ValidationTextBox", "name": "ToStopName", "caption": "Zielbahnhof (Name, z. B. Aulendorf)"},
        {"type": "ValidationTextBox", "name": "FromStopId", "caption": "Start-EVA (optional, z. B. 8001684)"},
        {"type": "ValidationTextBox", "name": "ToStopId", "caption": "Ziel-EVA (optional, z. B. 8000014)"},
        {"type": "ValidationTextBox", "name": "DBClientId", "caption": "DB Client ID"},
        {"type": "PasswordTextBox", "name": "DBApiKey", "caption": "DB API Key"},
        {"type": "NumberSpinner", "name": "WalkToStopMinutes", "caption": "Weg Haus → Bahnhof (min)", "minimum": 0, "maximum": 60},
        {"type": "NumberSpinner", "name": "SafetyBufferMinutes", "caption": "Sicherheitspuffer (min)", "minimum": 0, "maximum": 60},
        {"type": "NumberSpinner", "name": "DefaultArrivalLeadMinutes", "caption": "Wenn kein Termin gesetzt: gewünschte Ankunft in (min)", "minimum": 15, "maximum": 720},
        {"type": "NumberSpinner", "name": "LookAheadHours", "caption": "Suchfenster für Direktfahrten (Stunden)", "minimum": 1, "maximum": 8},
        {"type": "Label", "caption": "Hinweis: Die kostenlose Timetables API ist keine allgemeine A→B-Routing-API. Bis RIS::Journeys freigeschaltet ist, werden daher nur Direktverbindungen ausgewählt."}
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Straßenlage Baden-Württemberg",
      "items": [
        {"type": "CheckBox", "name": "EnableRoadworks", "caption": "MobiData BW Baustellen berücksichtigen"},
        {"type": "NumberSpinner", "name": "HomeLatitude", "caption": "Start-Breitengrad", "digits": 6},
        {"type": "NumberSpinner", "name": "HomeLongitude", "caption": "Start-Längengrad", "digits": 6},
        {"type": "NumberSpinner", "name": "DestinationLatitude", "caption": "Ziel-Breitengrad", "digits": 6},
        {"type": "NumberSpinner", "name": "DestinationLongitude", "caption": "Ziel-Längengrad", "digits": 6},
        {"type": "NumberSpinner", "name": "RoadCorridorKm", "caption": "Korridor um Luftlinie (km)", "minimum": 1, "maximum": 50}
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Aktualisierung",
      "items": [
        {"type": "NumberSpinner", "name": "UpdateIntervalSeconds", "caption": "Aktualisierungsintervall (s)", "minimum": 60, "maximum": 1800}
      ]
    }
  ],
  "actions": [
    {"type": "Button", "caption": "DB-Bahnhöfe auflösen", "onClick": "OMOB_ResolveStops($id);"},
    {"type": "Button", "caption": "Jetzt aktualisieren", "onClick": "OMOB_Update($id);"},
    {"type": "Button", "caption": "Verbindung zurücksetzen", "onClick": "OMOB_ResetJourney($id);"},
    {"type": "Button", "caption": "Testtermin: Ankunft in 60 Minuten", "onClick": "OMOB_SetTargetArrival($id, time() + 3600); OMOB_Update($id);"}
  ],
  "status": [
    {"code": 102, "icon": "active", "caption": "Aktiv"},
    {"code": 201, "icon": "error", "caption": "DB-Zugang oder Start/Ziel fehlt"},
    {"code": 202, "icon": "error", "caption": "DB Timetables Fehler / keine passende Direktverbindung"}
  ]
}
